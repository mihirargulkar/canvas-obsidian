# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Your institution's Canvas URL (no trailing slash)
CANVAS_URL=https://your-school.instructure.com

# Canvas → Account → Settings → New Access Token
CANVAS_TOKEN=

# https://aistudio.google.com/app/apikey — free tier is fine (ingestion only)
GEMINI_API_KEY=

# Expose your GRADES to the LLM client you connect over MCP. Off by default:
# everything else this serves is course material, grades are not. The local CLI
# (python -m canvas_vault.canvas grades) works either way and sends nothing out.
# CANVAS_ENABLE_GRADES=1

# Optional overrides
# CANVAS_TZ=America/New_York        # defaults to your Canvas account timezone
# SOFFICE=/path/to/soffice          # if LibreOffice isn't on $PATH
