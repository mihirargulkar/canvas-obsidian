# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Your institution's Canvas URL (no trailing slash)
CANVAS_URL=https://your-school.instructure.com

# Canvas → Account → Settings → New Access Token
CANVAS_TOKEN=

# https://aistudio.google.com/app/apikey — free tier is fine (ingestion only)
GEMINI_API_KEY=

# Optional overrides
# CANVAS_TZ=America/New_York        # defaults to your Canvas account timezone
# SOFFICE=/path/to/soffice          # if LibreOffice isn't on $PATH
